START=03
STOP=96

start() {
	if [ -c /dev/kmsg ]; then
		chown root:kmsg /dev/kmsg
		chmod 0664 /dev/kmsg
	fi
        /etc/scripts/find_recovery_partitions.sh >> /dev/kmsg 2>&1
}

stop() {
        echo "Stopping service .."
}
