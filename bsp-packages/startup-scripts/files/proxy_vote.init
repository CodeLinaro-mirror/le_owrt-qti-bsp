START=16
STOP=87

start(){
	echo "dummy_vote_for_reboot" > /sys/power/wake_unlock
}

stop(){
	# put a dummy vote to prevent apps collapse during reboot
	echo "dummy_vote_for_reboot" > /sys/power/wake_lock
}

